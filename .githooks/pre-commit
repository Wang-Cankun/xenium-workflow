#!/bin/sh
# Refuse a commit that adds a term from the Git-ignored .private-terms list:
# one case-insensitive fixed string per line, '#' comments allowed.
# `.githooks/pre-commit --all` scans every tracked file instead of the staged diff.
set -eu
root=$(git rev-parse --show-toplevel)
list="$root/.private-terms"
if [ ! -f "$list" ]; then
    echo "pre-commit: $list not found; private-term check skipped" >&2
    exit 0
fi
terms=$(mktemp)
trap 'rm -f "$terms"' EXIT
grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$list" > "$terms" || exit 0

if [ "${1:-}" = "--all" ]; then
    hits=$({ git -C "$root" ls-files | grep -i -F -f "$terms"
             git -C "$root" grep -n -I -i -F -f "$terms"; } || true)
else
    # Added lines as path:line: text, so a term in a staged path also matches.
    hits=$(git -C "$root" diff --cached -U0 --no-color --no-ext-diff --diff-filter=ACMR |
        awk '/^\+\+\+ /{f=substr($0,7); next}
             /^@@/{split($3,a,","); n=substr(a[1],2)+0; next}
             /^\+/{print f ":" n ": " substr($0,2); n++}' |
        grep -i -F -f "$terms" || true)
fi

if [ -n "$hits" ]; then
    echo "pre-commit: private terms from .private-terms found:" >&2
    echo "$hits" >&2
    exit 1
fi
